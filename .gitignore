# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local
.claude/

# data backups (keep originals only)
data/*.bak
data/*.json.bak
data/*.bak.*.json

# derived CSV (regenerate with `npm run export-csv`)
data/facilities_master.csv
data/facilities_master_*.csv

# transient batch CSVs prepared for sheet append
data/v*_additions_for_sheet.csv
data/*_research.csv
data/.*.csv
data/files.zip

# google service account key (local only)
data/.gcp-sheets-credentials.json

# script logs
scripts/*-failures.log

# os
Thumbs.db

.vercel

# Google Cloud Service Account credentials
data/.gcp-sheets-credentials.json
.gcp-*.json
