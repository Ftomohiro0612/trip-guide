{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memorip",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    {
      "pattern": "trip-guide.net/*",
      "zone_name": "trip-guide.net"
    },
    {
      "pattern": "www.trip-guide.net/*",
      "zone_name": "trip-guide.net"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/_memorip-runtime/*", "/_memorip-pages/*"]
  },
  "images": {
    "binding": "IMAGES"
  }
}
